<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>exam_bringup</name>
  <version>0.1.0</version>
  <description>Launches the multi-robot exploration exam and evaluates the team's explored volume.</description>
  <maintainer email="tangjingfan@gmail.com">jingfan</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>vehicle_simulator</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
